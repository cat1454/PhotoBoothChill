# URL-encode special characters in your PostgreSQL password before putting it in DATABASE_URL.
DATABASE_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/photobooth_native?schema=public"
JWT_SECRET="change-me-in-local-dev"
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_ASSET_BASE_URL="http://localhost:4000/assets"
WEB_PUBLIC_URL="http://localhost:3000"
STORAGE_ADAPTER="local"
STORAGE_ROOT="H:/photobooth/storage/runtime"
